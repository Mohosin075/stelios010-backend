# Application Configuration
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Super Admin Initial Credentials (Seeded on server start)
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="admin123"

# Twilio SMS / Verification Service (Optional)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_SERVICE_SID="your_twilio_service_sid"

# JWT & Authentication
JWT_SECRET="your_jwt_secret_key"
EXPIRES_IN=1d
REFRESH_TOKEN_SECRET="your_refresh_token_secret_key"
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASS_TOKEN="your_reset_pass_token_secret"
RESET_PASS_TOKEN_EXPIRES_IN=1h
PASSWORD_SALT=10

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_CLIENT_ID="your_stripe_client_id"

# PayPal Payment Gateway
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_MODE="sandbox"

# AWS S3 / DigitalOcean Spaces Storage
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your_bucket_name"
AWS_ENDPOINT="s3.amazonaws.com"

# Email Configuration (Nodemailer / SendGrid)
EMAIL="your_email@example.com"
APP_PASS="your_email_app_password"
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_EMAIL="no-reply@example.com"

# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key"

# URLs & Client Redirection Links
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"
BACKEND_IMAGE_URL="http://localhost:5000/uploads"
RESET_PASS_LINK="http://localhost:3000/reset-password"
